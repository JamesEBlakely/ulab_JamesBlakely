# Your code here
def second_values(array):
    # Returns the second element of each row of a two dimensional array
    values = []
    for row in array:
        values.append(row[1])
    return(values)
        
print(second_values(np.array([[2, 4, 6], [8, 10, 12], [14, 16, 18]])))





# Your comment here
# The NumPy array iterating section helped me with this function. 
# This section is helpful for understanding how to access any element in a multi-dimensional array.





# To take a nested list and return the second value in each row, you can simply treat each
# element of the outside list as a list itself. 
# For example, if we have a list that contains three lists
list = [[1,2,3],[4,5,6],[7,8,9]]
def nested_second_values(list):
    values = []
    for i in list:
        values.append(i[1])
    return(values)

print(nested_second_values(list))





# Your code here
def first_occurrence(arr,num):
    # Takes in an array and a number and returns the index where the number first appears in the array
    values = np.where(arr==num)
    return(values[0][0])
        
print(first_occurrence(np.array([1,2,3,4,4,3,2,1]),4))
print(first_occurrence(np.array([1,1,2,1]),1))





