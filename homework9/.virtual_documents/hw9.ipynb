# Your code here
def plot_line():
    plt.figure(figsize=(5,5))
    x = np.array([1,2,3,4,5])
    y = np.array([2,4,6,8,10])
    plt.plot(x,y, color='red',linestyle='-.',marker='o')
    plt.title("y vs x graph",fontsize=20) 
    plt.xlabel("x",fontsize=12)
    plt.ylabel("y",fontsize=12)
    plt.legend(["line"])
    plt.grid()
plot_line()





# Your code here

def plot_functions():
    # Calculates and plots f(x)=x^2 and g(x)=sqrt(x)
    x = np.linspace(0,10,100)
    f = x**2
    g = np.sqrt(x)

    plt.figure(figsize=(10,8))
    plt.plot(x,f,color='red',linestyle="-.",label="f(x)")
    plt.plot(x,g,color='blue',linestyle=":",label="g(x)")
    plt.xlabel("x")
    plt.ylabel("y")
    plt.title("Plots of f(x) and g(x)")
    plt.legend()
    plt.show()
    
    return(f,g)
plot_functions()






