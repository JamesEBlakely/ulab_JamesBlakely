# Import your module and/or your code here
def polar_plot(rmax):
    # Plots r=theta in polar
    r = np.linspace(0,rmax,50)
    theta = r
    fig = plt.figure()
    ax = fig.add_subplot(polar=True)
    ax.plot(theta, r,label="r=theta")
    ax.set_title("Polar plot")
    ax.legend(loc="upper right")
    
    plt.show()

polar_plot(5)





